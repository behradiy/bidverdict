{
  "manifest_version": 3,
  "name": "GovVerdict: Bid/No-Bid for SAM.gov Contracts",
  "short_name": "GovVerdict",
  "version": "1.1.0",
  "description": "Bid or no-bid on any SAM.gov contract opportunity in about a minute. Reads the notice and attachments and checks your fit.",
  "homepage_url": "https://govverdict.com",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Open GovVerdict",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "sidePanel",
    "storage"
  ],
  "host_permissions": [
    "https://sam.gov/*",
    "https://iae-fbo-attachments.s3.amazonaws.com/*"
  ]
}
